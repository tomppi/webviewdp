<?xml version="1.0" encoding="utf-8"?>
<!-- The app serves the harness UI to its own WebView from a loopback origin, so
     that origin is the single cleartext exception. The harness itself, and every
     other destination, stays HTTPS-only. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
